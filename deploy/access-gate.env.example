# access-gate 环境变量模板（真实模式）
#
# 安装：install -m 0640 deploy/access-gate.env.example /etc/access-gate/env
#       chown root:access-gate /etc/access-gate/env      # ★ 密钥只给服务进程读
#       # 然后填入真实值；**不要把这份文件提交进版本库**
#
# ★ 标「必需」的缺了会**拒绝启动**（fail-closed）——这是有意的：
#   坏配置在启动时暴露，而不是等第一个用户登录时才炸。

# ── 必需 ──
# 32 字节主密钥（64 位 hex 或 base64）。生成：openssl rand -hex 32
AG_MASTER_KEY=
# PostgreSQL 连接串
AG_DATABASE_URL=postgres://accessgate:CHANGE_ME@127.0.0.1:5432/accessgate
# 对外地址（OIDC redirect_uri 与 Cookie 域名都依赖它）
AG_PUBLIC_URL=https://gate.example.com
# OIDC 提供方
AG_OIDC_ISSUER=https://idp.example.com
AG_OIDC_CLIENT_ID=
AG_OIDC_CLIENT_SECRET=
AG_OIDC_REDIRECT_URI=https://gate.example.com/api/auth/callback
# 生产必须 Secure Cookie
AG_SECURE_COOKIES=1

# ── 运行 ──
AG_MODE=real
AG_PORT=8799

# ── 可选 ──
# 巡检节奏（毫秒；缺省 30000）
# AG_PATROL_INTERVAL_MS=30000
# 签到逻辑日期用的时区
# AG_CHECKIN_TIMEZONE=Asia/Shanghai

# ── 可选：真实 new-api 对接 ──
# AG_NEWAPI_BASE_URL=
# AG_NEWAPI_PAT=
# AG_NEWAPI_PAGE_SIZE=100

# ── 可选：LLM 网关（**有凭据才装配**，缺则插件无法调 LLM 也不产生费用）──
# AG_LLM_API_KEY=
# AG_LLM_BASE_URL=https://api.openai.com/v1
# AG_LLM_MODEL=gpt-4o-mini
